# Application
APP_URL=https://fullstack.mabrigkorie.org
FREE_MODULE_LIMIT=1

# MongoDB Atlas
# Recommended: only add the password as a deployment secret.
MONGODB_USERNAME=fullstack
MONGODB_PASSWORD=
MONGODB_CLUSTER_HOST=learnhub.07ozegd.mongodb.net
MONGODB_APP_NAME=learnhub
MONGODB_DB=full_stack_master_class

# Optional alternative: set a complete URI instead of the structured values above.
# If MONGODB_URI is present, it takes priority.
MONGODB_URI=

# Bootstrap staff access. Comma-separated emails.
ADMIN_EMAILS=victoryonline1@gmail.com
INSTRUCTOR_EMAILS=

# Fintigen central learner/enrollment management
# FINTIGEN_API_URL must include /api/v1.
FINTIGEN_API_URL=
FINTIGEN_FULLSTACK_SHARED_SECRET=
FINTIGEN_COURSE_SLUG=mabrig-full-stack-founder-pro
FINTIGEN_COURSE_TITLE=Full-Stack Master-Class

# AI — preferred provider: OpenRouter
OPENROUTER_API_KEY=
AI_MODEL=openai/gpt-5.4-mini
AI_FALLBACK_MODEL=openrouter/free
# Optional candidate used by Model Bench; does not change production automatically.
AI_CANDIDATE_MODEL=

# Optional fallback provider: Vercel AI Gateway
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1

# Transactional email (optional until configured)
RESEND_API_KEY=
EMAIL_FROM=

# Optional GitHub API token for higher rate limits/private verification workflows
GITHUB_TOKEN=

# Paystack
PAYSTACK_SECRET_KEY=
MASTERCLASS_PRICE_NGN=100000

# Referral programme: 1500 basis points = 15%
REFERRAL_COMMISSION_BPS=1500
